# Web/API ports
PORT=8787
VITE_API_BASE_URL=http://localhost:8787
# One-owner private studio login. ADMIN_PASSWORD is still accepted as a legacy fallback.
OWNER_EMAIL=
OWNER_PASSWORD=
ADMIN_PASSWORD=

# Video provider options: mock, fal, byteplus
VIDEO_PROVIDER=mock

# OpenAI brain/image/script layer. Keep server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Brain provider options: openai, openrouter
BRAIN_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=moonshotai/kimi-k2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://studio.nextbagchaser.com
OPENROUTER_APP_NAME=Next Bag Chaser Studio
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0-fast
OPENROUTER_VIDEO_RESOLUTION=480p
OPENROUTER_VIDEO_MAX_DURATION_SEC=4
OPENROUTER_VIDEO_POLL_ATTEMPTS=30
OPENROUTER_VIDEO_POLL_DELAY_MS=15000

# fal.ai Seedance 2.0 route
# Get from https://fal.ai/dashboard/keys and keep server-side only.
FAL_KEY=
SEEDANCE_DEFAULT_MODEL=bytedance/seedance-2.0/fast/image-to-video

# BytePlus / ModelArk route, kept as a future adapter because availability and endpoint access vary by region/account.
ARK_API_KEY=
BYTEPLUS_MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Voice provider options: mock, elevenlabs, openai
VOICE_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# Merch provider options: mock, printful, printify
MERCH_PROVIDER=mock
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Growth/ad/email provider variables. Store secrets only in .env or server secrets.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Resend founder-list sync and welcome email
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
RESEND_FROM_EMAIL=Next Bag Chaser <studio@nextbagchaser.com>
PUBLIC_SITE_URL=https://studio.nextbagchaser.com

# Story blog agent. Defaults to a local Ollama-compatible model on the VPS.
BLOG_LLM_PROVIDER=ollama
BLOG_LLM_BASE_URL=http://localhost:11434
BLOG_LLM_MODEL=qwen3
BLOG_LLM_TEMPERATURE=0.65
BLOG_RESEARCH_URLS=
BLOG_PUBLISH_TOKEN=

# Video agent. Defaults to the same local Ollama-style model as the blog agent.
VIDEO_AGENT_LLM_PROVIDER=ollama
VIDEO_AGENT_LLM_BASE_URL=http://localhost:11434
VIDEO_AGENT_LLM_MODEL=qwen3
VIDEO_AGENT_LLM_API_KEY=local
VIDEO_AGENT_REQUIRE_LLM=true
VIDEO_AGENT_LLM_TEMPERATURE=0.55
KEYFRAME_IMAGE_PROVIDER=mock
VIDEO_CLIP_PROVIDER=mock
VIDEO_AGENT_WAIT_FOR_CLIP=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_REFERENCE_LIMIT=6
OPENAI_VIDEO_MODEL=sora-2
OPENAI_VIDEO_SIZE=720x1280
OPENAI_VIDEO_POLL_ATTEMPTS=30
OPENAI_VIDEO_POLL_DELAY_MS=10000
STORYBOARD_DIRECTOR_PROVIDER=local
STORYBOARD_DIRECTOR_MODEL=gpt-5
STORYBOARD_DIRECTOR_REQUIRE_LIVE=false
STORYBOARD_FRAME_PROVIDER=mock
VIDEO_AGENT_RENDER_WIDTH=
VIDEO_AGENT_RENDER_HEIGHT=
VIDEO_AGENT_RENDER_DURATION_FRAMES=
VIDEO_AGENT_CHARACTER_ID=
VIDEO_AGENT_SCHEDULE_ENABLED=false
VIDEO_AGENT_SCHEDULE_TIMES=09:00,19:00
VIDEO_AGENT_SCHEDULE_TIMEZONE=server-local
VIDEO_AGENT_SCHEDULE_KEYFRAME_PROVIDER=mock
VIDEO_AGENT_SCHEDULE_CLIP_PROVIDER=mock
VIDEO_AGENT_SCHEDULE_VOICE_PROVIDER=mock
VIDEO_AGENT_SCHEDULE_STORYBOARD_DIRECTOR_PROVIDER=local
VIDEO_AGENT_SCHEDULE_STORYBOARD_FRAME_PROVIDER=mock
VIDEO_AGENT_SCHEDULE_STORYBOARD_ONLY=true
VIDEO_AGENT_SCHEDULE_CHARACTER_ID=
VIDEO_AGENT_SCHEDULE_CHARACTER_IDS=kairo,nia,malik,asha,jabari,tariq,mother-lall,papa-etienne,marius,selah
VIDEO_AGENT_SCHEDULE_WAIT_FOR_CLIP=false
VIDEO_AGENT_SCHEDULE_REQUIRE_LLM=false
